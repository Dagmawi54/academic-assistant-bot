# Telegram
BOT_TOKEN=your_bot_token_here
WEBHOOK_URL=https://your-app.onrender.com/webhook
WEBHOOK_SECRET=generate_a_random_secret_for_telegram_webhooks

# AI
GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here

# Database
# Local development only; production must use hosted PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./bot.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/academic_bot

# Optional Cloudflare Worker sync (leave blank until Worker is deployed and verified)
CLOUDFLARE_WORKER_URL=
CLOUDFLARE_SYNC_SECRET=

# Redis
REDIS_URL=redis://localhost:6379/0

# Bot Mode
APP_ENV=development
USE_POLLING=true

# Logging
LOG_LEVEL=INFO
